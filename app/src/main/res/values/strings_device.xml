    <string name="device_yonker_asleep_title">Your machine took a nap</string>
    <string name="device_yonker_asleep_message">It switches itself off when it\'s left waiting, to save battery. Switch it on and reconnect when you\'re ready.</string>
    <string name="device_yonker_couldnt_reach">We couldn\'t reach your machine</string>
    <string name="device_yonker_failed_tip">Tip: switch the machine off and on, keep it close, and try again.</string>
    <string name="device_yonker_accurate_reading">For an accurate reading</string>
    <string name="device_yonker_bp_tip_1">Sit quietly for 5 minutes with your back supported and feet flat.</string>
    <string name="device_yonker_bp_tip_2">Wrap the cuff on your bare upper arm, level with your heart.</string>
    <string name="device_yonker_bp_tip_3">Stay still and don\'t talk while the cuff works.</string>
    <string name="device_yonker_oxi_tip_1">Warm hands read better. Rub them together if they\'re cold.</string>
    <string name="device_yonker_oxi_tip_2">Use a finger without nail polish and rest your hand on a table.</string>
    <string name="device_yonker_oxi_tip_3">Hold still for about 10 seconds while the numbers settle.</string>
    <string name="device_yonker_done_disconnect">I\'m done, disconnect</string>
