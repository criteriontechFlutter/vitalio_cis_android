    <string name="device_omron_how_to_pair">How to pair</string>
    <string name="device_omron_pair_step_1">Put batteries in and set the date &amp; time on the device (see its manual).</string>
    <string name="device_omron_pair_step_2">Press and hold the Bluetooth / transfer button until \"P\" blinks on the screen.</string>
    <string name="device_omron_pair_step_3">Keep the device next to your phone and tap Pair above.</string>
    <string name="device_omron_how_to_sync">How to sync</string>
    <string name="device_omron_sync_bp_step_1">Take your blood pressure as User %1$d on the device.</string>
    <string name="device_omron_sync_bp_step_2">Press the Bluetooth / transfer button once (some models send automatically).</string>
    <string name="device_omron_sync_bp_step_3">Tap Sync above, check your latest reading and tap Save.</string>
    <string name="device_omron_sync_scale_step_1">Step on the scale and wait for the reading.</string>
    <string name="device_omron_sync_scale_step_2">Keep the scale on; it sends readings over Bluetooth.</string>
    <string name="device_omron_sync_scale_step_3">Tap Sync above.</string>
    <string name="device_omron_remove_hint">After removing, also forget the device in your phone\'s Bluetooth settings before pairing again.</string>
    <string name="device_omron_supported_models_intro">No need to pick your model: the app recognises it while pairing. These Omron models work:</string>
    <string name="device_omron_pick_user">Pick the user you measure as on the device. Readings are stored per user.</string>
    <string name="device_omron_clock_not_set">The monitor\'s clock isn\'t set, so the measured time is unknown. Set the date &amp; time on the device.</string>
    <string name="device_omron_weight_not_stored">Weight is shown here only — the server doesn\'t store weight from devices yet.</string>
