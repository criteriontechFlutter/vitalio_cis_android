    <string name="device_hc_how_to_connect">How to connect your watch</string>
    <string name="device_hc_connect_step_1">Pair your watch with its app (Samsung Health, Fitbit, Garmin Connect, Mi Fitness, NoiseFit…)</string>
    <string name="device_hc_connect_step_2">In that app, turn on Health Connect sync — e.g. Samsung Health → Settings → Health Connect</string>
