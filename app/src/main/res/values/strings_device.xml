    <string name="device_bp_meaning_0_advice">Nicely in the normal range. Keep it up.</string>
    <string name="device_bp_meaning_1_title">Just a little above ideal</string>
    <string name="device_bp_meaning_1_advice">Nothing to worry about now, but worth keeping an eye on.</string>
    <string name="device_bp_meaning_2_title">A bit higher than normal</string>
    <string name="device_bp_meaning_2_advice">Rest for 5 minutes and measure again to be sure.</string>
    <string name="device_bp_meaning_3_title">Your blood pressure is high</string>
    <string name="device_bp_meaning_3_advice">Measure again after resting. If it stays this high, talk to your doctor.</string>
    <string name="device_bp_meaning_4_title">This reading is very high</string>
    <string name="device_bp_meaning_4_advice">Sit and rest, then measure again. If it\'s still this high or you feel unwell, get medical help right away.</string>
    <string name="device_spo2_meaning_healthy_title">Your oxygen level looks healthy</string>
    <string name="device_spo2_meaning_healthy_advice">Right where it should be.</string>
    <string name="device_spo2_meaning_little_low_title">Your oxygen is a little low</string>
    <string name="device_spo2_meaning_little_low_advice">Sit upright, take a few slow breaths and measure again.</string>
    <string name="device_spo2_meaning_low_title">Your oxygen level is low</string>
